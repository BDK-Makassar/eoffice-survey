# Diisi otomatis oleh Vercel saat Anda menyambungkan integrasi "Neon" dari tab Storage
# (atau Vercel Marketplace). Untuk pengembangan lokal, salin connection string dari
# dashboard Neon (https://console.neon.tech) ke file .env.local jika ingin menguji
# koneksi database secara lokal.
DATABASE_URL=

# Kata sandi sederhana untuk membuka halaman /admin (dashboard hasil survei).
ADMIN_KEY=ubah-password-ini
